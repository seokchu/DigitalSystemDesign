# =============================================================================
# Quartus 핀 배정 파일 (장현석_역할별내용.pptx 산출물 : fnd_driver.qsf)
# 보드 : HBE-Combo II-SE  (Altera Cyclone II EP2C8Q208C8)
#
# ★ 중요 안내 ★
#   아래 핀 번호는 HBE-Combo II-SE 사용자 매뉴얼의 핀 배치를 참조한
#   "전형적인 예시" 입니다. 보드 리비전에 따라 핀 번호가 달라질 수
#   있으므로 본 파일은 그대로 사용하기 전에 반드시 보드 매뉴얼을 보고
#   본인 보드의 핀 번호로 갱신해야 합니다.
#
#   특히 FND 의 a~g, dp 핀 매핑이 보드마다 비트 순서가 다른 경우가 많아,
#   본 모듈 내부의 비트 약속 (seg(7)=a, seg(0)=dp) 과 다르다면
#   여기서 핀만 뒤집어 할당하면 됩니다 (모듈 내부 코드는 수정 불필요).
#
#   [확인 항목]
#     - DEVICE          : EP2C8Q208C8
#     - 보드 클럭        : 1MHz 가 들어오는 핀 (점퍼 설정도 함께 확인)
#     - 푸시버튼 RESET  : active-low 누름 버튼
#     - 4-Digit FND     : seg a~g+dp, COM1~4
# =============================================================================

# --- Device --------------------------------------------------------------
set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C8Q208C8
set_global_assignment -name TOP_LEVEL_ENTITY fnd_driver

# --- 컴파일 옵션 ---------------------------------------------------------
set_global_assignment -name VHDL_INPUT_VERSION VHDL_1993
set_global_assignment -name VHDL_SHOW_LMF_MAPPING_MESSAGES OFF

# --- 소스 파일 추가 ------------------------------------------------------
set_global_assignment -name VHDL_FILE ../src/seg7_decoder.vhd
set_global_assignment -name VHDL_FILE ../src/clk_divider.vhd
set_global_assignment -name VHDL_FILE ../src/digit_scanner.vhd
set_global_assignment -name VHDL_FILE ../src/display_policy.vhd
set_global_assignment -name VHDL_FILE ../src/fnd_driver.vhd

# =============================================================================
# 핀 배정 (※ 실제 보드 매뉴얼로 검증 후 수정 필수)
# =============================================================================

# --- 시스템 클럭 (1MHz) ---------------------------------------------------
set_location_assignment PIN_23  -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk

# --- Reset (push button, active-low) -------------------------------------
set_location_assignment PIN_24  -to reset_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to reset_n

# --- 외부에서 들어오는 신호 (이서영/손동한/정용성) -------------------------
# 통합 시에는 이 신호들이 다른 모듈의 출력에 연결되므로 핀 할당 불필요.
# 단독 다운로드(2주차 검증) 시 DIP 스위치/푸시버튼으로 강제 인가하려면
# 아래 핀에 임시로 연결 가능. 핀번호는 보드 매뉴얼 확인 후 채우기.
# set_location_assignment PIN_xx -to fsm_state[2]
# set_location_assignment PIN_xx -to fsm_state[1]
# set_location_assignment PIN_xx -to fsm_state[0]
# set_location_assignment PIN_xx -to mask_enable
# set_location_assignment PIN_xx -to input_count[2]
# set_location_assignment PIN_xx -to input_count[1]
# set_location_assignment PIN_xx -to input_count[0]
# set_location_assignment PIN_xx -to digit_data[15] ... [0]

# --- 4-Digit FND : Segment ------------------------------------------------
# 본 모듈 약속 :  fnd_seg(7)=a , (6)=b , (5)=c , (4)=d ,
#                 fnd_seg(3)=e , (2)=f , (1)=g , (0)=dp
# 보드 매뉴얼의 a~g/dp 와 동일 순서로 할당하면 됨.
set_location_assignment PIN_50  -to fnd_seg[7]  ;# a
set_location_assignment PIN_51  -to fnd_seg[6]  ;# b
set_location_assignment PIN_52  -to fnd_seg[5]  ;# c
set_location_assignment PIN_53  -to fnd_seg[4]  ;# d
set_location_assignment PIN_54  -to fnd_seg[3]  ;# e
set_location_assignment PIN_55  -to fnd_seg[2]  ;# f
set_location_assignment PIN_56  -to fnd_seg[1]  ;# g
set_location_assignment PIN_57  -to fnd_seg[0]  ;# dp

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to fnd_seg[*]

# --- 4-Digit FND : COM (active-low, one-hot) -----------------------------
# 본 모듈 약속 :  fnd_com(0)=COM1 ... fnd_com(3)=COM4
set_location_assignment PIN_60  -to fnd_com[0]  ;# COM1 (Digit1)
set_location_assignment PIN_61  -to fnd_com[1]  ;# COM2 (Digit2)
set_location_assignment PIN_62  -to fnd_com[2]  ;# COM3 (Digit3)
set_location_assignment PIN_63  -to fnd_com[3]  ;# COM4 (Digit4)

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to fnd_com[*]
